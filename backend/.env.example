NODE_ENV=development
PORT=4000

# Local Docker database (docker compose up -d db). On AWS this points at RDS.
DATABASE_URL=postgres://parkit:parkit@localhost:5433/parkit
# Set to true on AWS so the connection to RDS uses TLS.
DATABASE_SSL=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# local = files under ./uploads, s3 = S3 bucket (Phase 4)
STORAGE_DRIVER=local
AWS_REGION=ap-south-1
S3_ASSETS_BUCKET=

# Optional SNS topic for booking notifications (Phase 4)
SNS_TOPIC_ARN=
