NODE_ENV=development
PORT=4000

# Local Docker database (docker compose up -d db). On AWS this points at RDS.
DATABASE_URL=postgres://parkit:parkit@localhost:5433/parkit
# Set to true on AWS so the connection to RDS uses TLS.
DATABASE_SSL=false

JWT_SECRET=change-me-to-a-long-random-string

# First admin account created by `npm run seed`. Outside development the seed refuses to run
# without ADMIN_PASSWORD or with the development default (on AWS it comes from Parameter Store).
ADMIN_EMAIL=admin@parkit.local
ADMIN_PASSWORD=admin12345
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# local = files under ./uploads, s3 = S3 bucket (pre-signed URLs, valid 15 minutes).
# On AWS Academy (us-east-1) the EC2 instance uses LabInstanceProfile: credentials come from the
# instance role automatically. Never put access keys here.
STORAGE_DRIVER=local
AWS_REGION=us-east-1
# Required when STORAGE_DRIVER=s3 (private bucket for QR images).
S3_ASSETS_BUCKET=

# Local upload directory for the local storage driver (QR images).
UPLOADS_DIR=./uploads

# The facility this API serves (the seed creates id 1).
FACILITY_ID=1

# Reverse proxies in front of the API, so rate limiting sees the real client IP.
# 0 = off (local). On AWS use 2 (Nginx + CloudFront).
TRUST_PROXY=0

# Max register/login requests per minute per IP.
AUTH_RATE_LIMIT_MAX=10

# Optional SNS topic for booking emails (D21). Empty = no emails. On AWS the template fills it in
# when BookingEmails is yes; credentials come from the instance role.
SNS_TOPIC_ARN=
